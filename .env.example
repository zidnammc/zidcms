# ZidCMS environment variables — names and descriptions only. Never commit real values.
# Local development: copy the admin block to apps/admin/.env.local (gitignored).

# ---------- apps/admin (Vercel project "admin") ----------
# Auth.js cookie/JWT signing secret (>= 32 random bytes, base64).
AUTH_SECRET=
# Google OAuth client (consent screen "External", scopes: openid email profile).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated allowlist of admin Google accounts. Private: never write the real value into the repo.
ADMIN_EMAILS=
# Public origin of the admin app, e.g. https://zidcms-admin.vercel.app (used for Origin checks).
ADMIN_URL=
# dev | prod — shown as the environment badge.
ZIDCMS_ENV=dev
# Apps Script web-app /exec URL. Private.
GAS_WEBAPP_URL=
# HMAC-SHA256 secret shared with Apps Script Script Property HMAC_SECRET (>= 32 random bytes, base64).
GAS_HMAC_SECRET=
# Publish target: github (default) or local (development only: writes into apps/web on disk).
PUBLISH_TARGET=github
# Fine-grained PAT: this repository only; Contents read/write, Commit statuses read.
GITHUB_TOKEN=
# owner/repo and branch that the web project deploys from.
GITHUB_REPO=
GITHUB_BRANCH=main
# Path of the web app inside the repo (default apps/web).
CONTENT_ROOT=apps/web
# Substring of the GitHub commit-status context Vercel reports for the web project (default "Vercel").
VERCEL_STATUS_CONTEXT=Vercel
# Public site origin, e.g. https://zidcms-web.vercel.app (canonical URLs + publish verification).
PUBLIC_SITE_URL=
# Local only: enables the e-mail "dev login" when running `next dev`. Ignored in production builds and on Vercel.
ZIDCMS_DEV_LOGIN=false
# Optional: debug logging.
LOG_LEVEL=info

# ---------- apps/web (Vercel project "web", build-time only) ----------
# Same value as PUBLIC_SITE_URL.
SITE_URL=

# ---------- Apps Script Script Properties (set in the Apps Script editor, not here) ----------
# HMAC_SECRET      same value as GAS_HMAC_SECRET
# ENVIRONMENT      dev | prod
# MEDIA_FOLDER_ID  optional; system.setup creates a private Drive folder when empty

# ---------- local GAS emulator (services/apps-script dev server) ----------
# GAS_DEV_PORT=8787
# GAS_DEV_LATENCY_MS=0
