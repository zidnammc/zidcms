{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "[ \"$VERCEL_ENV\" != \"production\" ] || { [ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- :/apps/admin :/packages :/pnpm-lock.yaml :/package.json; }",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "release": true,
      "*": false
    }
  }
}
